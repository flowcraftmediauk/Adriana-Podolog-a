{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile stored under their own UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name from Google Auth or user input."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "Verified user email address."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional profile photo URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "TurnoRequest": {
      "title": "TurnoRequest",
      "description": "Appointment inquiry submitted by an authenticated user for Adriana Podología.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "patientName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Full name of the person requesting the appointment."
        },
        "whatsappNumber": {
          "type": "string",
          "minLength": 6,
          "maxLength": 30,
          "pattern": "^[0-9+\\-()\\s]{6,30}$",
          "description": "Contact phone or WhatsApp number."
        },
        "preferredShift": {
          "type": "string",
          "enum": ["manana", "tarde", "a_convenir"],
          "description": "Preferred time of day for the appointment."
        },
        "note": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500,
          "description": "Brief consultation note."
        },
        "status": {
          "type": "string",
          "enum": ["pendiente", "enviado_whatsapp", "cancelado"],
          "description": "Current status of the inquiry."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "userId",
        "patientName",
        "whatsappNumber",
        "preferredShift",
        "note",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles isolated per authenticated UID."
    },
    "/turnoRequests/{requestId}": {
      "schema": { "$ref": "#/entities/TurnoRequest" },
      "description": "Appointment inquiry records owned by individual authenticated users."
    }
  }
}
